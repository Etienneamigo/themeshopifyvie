{%- comment -%}
  Product Reviews Section
  Displays reviews from metaobjects and a submission form.
  Reviews are stored as metaobject type "review" and filtered by product.
{%- endcomment -%}

{%- liquid
  assign all_reviews = shop.metaobjects.review.values
  assign approved_reviews = ''
  assign pinned_reviews = ''
  assign regular_reviews = ''
  assign total_rating = 0
  assign review_count = 0

  for review in all_reviews
    assign review_status = review.status.value | downcase
    assign review_product = review.product.value

    if review_status == 'approved' and review_product.id == product.id
      assign review_count = review_count | plus: 1
      assign r_val = review.rating.value | times: 1
      assign total_rating = total_rating | plus: r_val

      if review.pinned.value == true
        if pinned_reviews == ''
          assign pinned_reviews = review.id
        else
          assign pinned_reviews = pinned_reviews | append: ',' | append: review.id
        endif
      else
        if regular_reviews == ''
          assign regular_reviews = review.id
        else
          assign regular_reviews = regular_reviews | append: ',' | append: review.id
        endif
      endif
    endif
  endfor

  if review_count > 0
    assign average_rating = total_rating | times: 10 | divided_by: review_count
    assign average_whole = average_rating | divided_by: 10
    assign average_decimal = average_rating | modulo: 10
  else
    assign average_whole = 0
    assign average_decimal = 0
  endif

  assign average_rounded = average_whole
  if average_decimal >= 5
    assign average_rounded = average_whole | plus: 1
  endif

  comment
    Check customer purchase status for form display
  endcomment
  assign has_purchased = false
  if customer
    for order in customer.orders
      for line_item in order.line_items
        if line_item.product_id == product.id
          assign has_purchased = true
          break
        endif
      endfor
      if has_purchased
        break
      endif
    endfor
  endif
-%}

<div
  class="product-reviews section spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  id="reviews"
>
  <div class="product-reviews__container page-width">
    {%- comment -%} Header with average rating {%- endcomment -%}
    <div class="product-reviews__header">
      <h2 class="product-reviews__title">{{ section.settings.heading | default: 'Avis clients' }}</h2>

      {%- if review_count > 0 -%}
        <div class="product-reviews__summary">
          <div class="product-reviews__average">
            <span class="product-reviews__average-number">{{ average_whole }}.{{ average_decimal }}</span>
            {%- render 'review-stars', rating: average_rounded, size: 'large' -%}
          </div>
          <span class="product-reviews__count">
            {{ review_count }} avis
          </span>
        </div>
      {%- else -%}
        <p class="product-reviews__empty">Aucun avis pour le moment.</p>
      {%- endif -%}
    </div>

    {%- comment -%} Reviews list {%- endcomment -%}
    {%- if review_count > 0 -%}
      <div class="product-reviews__list">
        {%- comment -%} Pinned reviews first {%- endcomment -%}
        {%- for review in all_reviews -%}
          {%- liquid
            assign review_status = review.status.value | downcase
            assign review_product = review.product.value
          -%}
          {%- if review_status == 'approved' and review_product.id == product.id and review.pinned.value == true -%}
            <div class="product-reviews__item product-reviews__item--pinned">
              <div class="product-reviews__item-header">
                <div class="product-reviews__item-rating">
                  {%- render 'review-stars', rating: review.rating.value, size: 'small' -%}
                </div>
                <div class="product-reviews__item-meta">
                  <span class="product-reviews__item-author">{{ review.author_name.value }}</span>
                  {%- if review.verified_badge.value == true -%}
                    <span class="product-reviews__verified-badge">
                      <svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M10 0L12.2 3.6L16.18 2.5L15.68 6.6L19.51 8.54L16.8 11.6L18.09 15.56L14.02 15.56L12.2 19.14L10 16L7.8 19.14L5.98 15.56L1.91 15.56L3.2 11.6L0.49 8.54L4.32 6.6L3.82 2.5L7.8 3.6L10 0Z" fill="currentColor"/>
                        <path d="M7 10L9 12L13 8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Achat vérifié
                    </span>
                  {%- endif -%}
                </div>
              </div>
              {%- if review.title.value != blank -%}
                <h3 class="product-reviews__item-title">{{ review.title.value }}</h3>
              {%- endif -%}
              <div class="product-reviews__item-body">{{ review.body.value }}</div>
              <div class="product-reviews__item-date">
                {%- assign review_date = review.review_date.value -%}
                {%- if review_date != blank -%}
                  {{ review_date | date: "%d/%m/%Y" }}
                {%- endif -%}
              </div>
              <span class="product-reviews__pin-label">Épinglé</span>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Regular reviews {%- endcomment -%}
        {%- for review in all_reviews -%}
          {%- liquid
            assign review_status = review.status.value | downcase
            assign review_product = review.product.value
          -%}
          {%- if review_status == 'approved' and review_product.id == product.id and review.pinned.value != true -%}
            <div class="product-reviews__item">
              <div class="product-reviews__item-header">
                <div class="product-reviews__item-rating">
                  {%- render 'review-stars', rating: review.rating.value, size: 'small' -%}
                </div>
                <div class="product-reviews__item-meta">
                  <span class="product-reviews__item-author">{{ review.author_name.value }}</span>
                  {%- if review.verified_badge.value == true -%}
                    <span class="product-reviews__verified-badge">
                      <svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M10 0L12.2 3.6L16.18 2.5L15.68 6.6L19.51 8.54L16.8 11.6L18.09 15.56L14.02 15.56L12.2 19.14L10 16L7.8 19.14L5.98 15.56L1.91 15.56L3.2 11.6L0.49 8.54L4.32 6.6L3.82 2.5L7.8 3.6L10 0Z" fill="currentColor"/>
                        <path d="M7 10L9 12L13 8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Achat vérifié
                    </span>
                  {%- endif -%}
                </div>
              </div>
              {%- if review.title.value != blank -%}
                <h3 class="product-reviews__item-title">{{ review.title.value }}</h3>
              {%- endif -%}
              <div class="product-reviews__item-body">{{ review.body.value }}</div>
              <div class="product-reviews__item-date">
                {%- assign review_date = review.review_date.value -%}
                {%- if review_date != blank -%}
                  {{ review_date | date: "%d/%m/%Y" }}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Review submission form {%- endcomment -%}
    {%- if section.settings.show_form -%}
      <div class="product-reviews__form-section">
        <h3 class="product-reviews__form-title">Laisser un avis</h3>

        {%- if customer == nil -%}
          <div class="product-reviews__form-notice">
            <p>Connectez-vous pour laisser un avis.</p>
            <a href="/account/login" class="product-reviews__form-link button">Se connecter</a>
          </div>
        {%- elsif has_purchased == false -%}
          <div class="product-reviews__form-notice">
            <p>Seuls les clients ayant acheté ce produit peuvent laisser un avis.</p>
          </div>
        {%- else -%}
          {%- assign form_id = 'review-form-' | append: product.id -%}
          <div class="product-reviews__form-wrapper" id="{{ form_id }}-wrapper">
            {%- form 'contact', id: form_id, class: 'product-reviews__form' -%}
              {%- if form.posted_successfully? -%}
                <div class="product-reviews__form-success">
                  <p>Merci pour votre avis ! Il sera publié après modération.</p>
                </div>
              {%- endif -%}

              {%- if form.errors -%}
                <div class="product-reviews__form-errors">
                  <p>Une erreur est survenue. Veuillez réessayer.</p>
                </div>
              {%- endif -%}

              <input type="hidden" name="contact[Produit]" value="{{ product.title }} ({{ product.handle }})">
              <input type="hidden" name="contact[Product_ID]" value="{{ product.id }}">
              <input type="hidden" name="contact[Type]" value="Avis produit">

              <div class="product-reviews__form-field">
                <label for="{{ form_id }}-rating" class="product-reviews__form-label">Note *</label>
                <div class="product-reviews__rating-select" id="{{ form_id }}-rating-select">
                  {%- for i in (1..5) -%}
                    <label class="product-reviews__rating-option">
                      <input
                        type="radio"
                        name="contact[Note]"
                        value="{{ i }}"
                        required
                        class="product-reviews__rating-radio"
                        {% if i == 5 %}checked{% endif %}
                      >
                      <svg class="product-reviews__rating-star" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="{{ i }} étoile{% if i > 1 %}s{% endif %}">
                        <path d="M10 1.5L12.39 6.9L18.18 7.44L13.83 11.29L15.18 17L10 13.77L4.82 17L6.17 11.29L1.82 7.44L7.61 6.9L10 1.5Z" fill="currentColor"/>
                      </svg>
                    </label>
                  {%- endfor -%}
                </div>
              </div>

              <div class="product-reviews__form-field">
                <label for="{{ form_id }}-title" class="product-reviews__form-label">Titre</label>
                <input
                  type="text"
                  id="{{ form_id }}-title"
                  name="contact[Titre_avis]"
                  class="product-reviews__form-input"
                  placeholder="Résumez votre expérience"
                  maxlength="120"
                >
              </div>

              <div class="product-reviews__form-field">
                <label for="{{ form_id }}-body" class="product-reviews__form-label">Votre avis *</label>
                <textarea
                  id="{{ form_id }}-body"
                  name="contact[body]"
                  class="product-reviews__form-textarea"
                  rows="4"
                  required
                  placeholder="Partagez votre expérience avec ce produit..."
                  maxlength="2000"
                ></textarea>
              </div>

              <input type="hidden" name="contact[email]" value="{{ customer.email }}">
              <input type="hidden" name="contact[Nom_client]" value="{{ customer.name }}">

              <button type="submit" class="product-reviews__form-submit button">
                Envoyer mon avis
              </button>
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-reviews {
    width: 100%;
  }

  .product-reviews__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .product-reviews__header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .product-reviews__title {
    font-family: var(--font-primary--family);
    font-size: var(--font-size--h4);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
  }

  .product-reviews__summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .product-reviews__average {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .product-reviews__average-number {
    font-family: var(--font-primary--family);
    font-size: 1.75rem;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .product-reviews__count {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .product-reviews__empty {
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    opacity: 0.6;
    font-style: italic;
  }

  /* Stars */
  .review-stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: #C9A96E;
  }

  .review-stars--small .review-star {
    width: 14px;
    height: 14px;
  }

  .review-stars--medium .review-star {
    width: 18px;
    height: 18px;
  }

  .review-stars--large .review-star {
    width: 22px;
    height: 22px;
  }

  .review-star--empty {
    opacity: 0.3;
  }

  /* Review items */
  .product-reviews__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .product-reviews__item {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .product-reviews__item--pinned {
    padding: 1.5rem;
    border: 1px solid #C9A96E33;
    border-radius: 4px;
    background: #C9A96E08;
    margin-bottom: 0.5rem;
  }

  .product-reviews__item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .product-reviews__item-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .product-reviews__item-author {
    font-family: var(--font-primary--family);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .product-reviews__verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-family: var(--font-body--family);
    color: #C9A96E;
    letter-spacing: 0.02em;
  }

  .product-reviews__verified-badge svg {
    color: #C9A96E;
    flex-shrink: 0;
  }

  .product-reviews__item-title {
    font-family: var(--font-primary--family);
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
    letter-spacing: 0.02em;
  }

  .product-reviews__item-body {
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin-bottom: 0.5rem;
    white-space: pre-line;
    opacity: 0.85;
  }

  .product-reviews__item-date {
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    opacity: 0.45;
  }

  .product-reviews__pin-label {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    font-family: var(--font-body--family);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #C9A96E;
    opacity: 0.7;
  }

  /* Form section */
  .product-reviews__form-section {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .product-reviews__form-title {
    font-family: var(--font-primary--family);
    font-size: var(--font-size--h5);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 1.25rem 0;
  }

  .product-reviews__form-notice {
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    padding: 1.25rem;
    border-radius: 4px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .product-reviews__form-notice p {
    margin: 0 0 0.75rem 0;
  }

  .product-reviews__form-notice p:last-child {
    margin-bottom: 0;
  }

  .product-reviews__form-link {
    display: inline-block;
    margin-top: 0.25rem;
  }

  .product-reviews__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 600px;
  }

  .product-reviews__form-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .product-reviews__form-label {
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .product-reviews__form-input,
  .product-reviews__form-textarea {
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 4px;
    background: transparent;
    color: var(--color-foreground);
    transition: border-color 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .product-reviews__form-input:focus,
  .product-reviews__form-textarea:focus {
    outline: none;
    border-color: #C9A96E;
  }

  .product-reviews__form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  /* Rating select */
  .product-reviews__rating-select {
    display: flex;
    gap: 4px;
    flex-direction: row;
  }

  .product-reviews__rating-option {
    cursor: pointer;
    display: flex;
  }

  .product-reviews__rating-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .product-reviews__rating-star {
    width: 28px;
    height: 28px;
    color: rgb(var(--color-foreground-rgb) / 0.2);
    transition: color 0.15s ease;
  }

  .product-reviews__rating-radio:checked ~ .product-reviews__rating-star,
  .product-reviews__rating-option:hover .product-reviews__rating-star {
    color: #C9A96E;
  }

  .product-reviews__rating-select:has(.product-reviews__rating-option:hover) .product-reviews__rating-star {
    color: rgb(var(--color-foreground-rgb) / 0.2);
  }

  .product-reviews__rating-select:has(.product-reviews__rating-option:hover) .product-reviews__rating-option:hover .product-reviews__rating-star,
  .product-reviews__rating-select:has(.product-reviews__rating-option:hover) .product-reviews__rating-option:hover ~ .product-reviews__rating-option .product-reviews__rating-star {
    color: rgb(var(--color-foreground-rgb) / 0.2);
  }

  .product-reviews__rating-select .product-reviews__rating-option:hover .product-reviews__rating-star {
    color: #C9A96E !important;
  }

  /* Fill all stars up to and including the hovered one */
  .product-reviews__rating-select .product-reviews__rating-option:has(~ .product-reviews__rating-option:hover) .product-reviews__rating-star,
  .product-reviews__rating-select .product-reviews__rating-option:hover .product-reviews__rating-star {
    color: #C9A96E !important;
  }

  /* When not hovering, fill stars up to and including checked */
  .product-reviews__rating-select:not(:hover) .product-reviews__rating-option:has(.product-reviews__rating-radio:checked) .product-reviews__rating-star,
  .product-reviews__rating-select:not(:hover) .product-reviews__rating-option:has(~ .product-reviews__rating-option .product-reviews__rating-radio:checked) .product-reviews__rating-star {
    color: #C9A96E;
  }

  .product-reviews__form-submit {
    align-self: flex-start;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.875rem 2rem;
    cursor: pointer;
    margin-top: 0.25rem;
  }

  .product-reviews__form-success {
    padding: 1rem 1.25rem;
    background: #C9A96E15;
    border: 1px solid #C9A96E40;
    border-radius: 4px;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
  }

  .product-reviews__form-success p {
    margin: 0;
  }

  .product-reviews__form-errors {
    padding: 1rem 1.25rem;
    background: #dc354515;
    border: 1px solid #dc354540;
    border-radius: 4px;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
  }

  .product-reviews__form-errors p {
    margin: 0;
  }

  @media (max-width: 749px) {
    .product-reviews__container {
      padding: 0 1rem;
    }

    .product-reviews__item--pinned {
      padding: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avis produit",
  "class": "product-reviews-section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de la section",
      "default": "Avis clients"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Afficher le formulaire d'avis",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Haut",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bas",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "templates": ["product"],
  "presets": [
    {
      "name": "Avis produit"
    }
  ]
}
{% endschema %}
