ize":"small","enable_infinite_scroll":true,"products_per_page":24,"product_grid_width":"centered","full_width_on_mobile":true,"columns_gap_horizontal":16,"columns_gap_vertical":24,"padding-inline-start":0,"padding-inline-end":0,"color_scheme":"scheme-1","padding-block-start":0,"padding-block-end":32}},"section_mf3kwU":{"type":"section","blocks":{"text_XCn9fQ":{"type":"text","name":"t:names.heading","settings":{"text":"<h2>Foire aux questions<\/h2>","width":"fit-content","max_width":"narrow","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"accordion_AMxmYb":{"type":"accordion","name":"t:names.accordion","settings":{"icon":"caret","dividers":true,"type_preset":"h5","inherit_color_scheme":true,"color_scheme":"","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"accordion_row_9eH3YQ":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Quel est le délai estimé de livraison de mes bijoux ?","open_by_default":true,"icon":"none","width":20},"blocks":{"text_znHWcF":{"type":"text","name":"t:names.text","settings":{"text":"<p><br\/>Nous expédions les commandes dans un délai de <strong>24 à 48 heures<\/strong>. Le temps <br\/>de livraison de votre commande sera déterminé par <strong>le mode d'expédition <br\/>que vous sélectionnerez lors du paiement<\/strong>. Veuillez noter que le délai de<br\/> livraison peut être prolongé pendant les périodes de promotions, les <br\/>fêtes ou les événements exceptionnels.<br\/><br\/><\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_znHWcF"]},"accordion_row_6BRHeG":{"type":"_accordion-row","settings":{"heading":"Est-il possible de garder mes bijoux sous la douche ou à la plage ?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_kJgQQz":{"type":"text","settings":{"text":"<p>Nos bijoux sont conçus en <strong>acier inoxydable<\/strong>, ce qui leur permet de résister à l’eau douce comme à l’eau de mer, au chlore ainsi qu’aux produits du quotidien.<\/p><p><strong>Vous pouvez donc les porter à la plage ou sous la douche en toute sérénité<\/strong>. Pour préserver durablement leur éclat, nous vous conseillons simplement de les rincer à l’eau claire puis de les sécher délicatement après exposition.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_kJgQQz"]},"accordion_row_KM8rYE":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Votre site est-il fiable et sécurisé ?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_zj3Mdr":{"type":"text","name":"t:names.text","settings":{"text":"<p>Absolument. La navigation sur notre site est protégée par un protocole de sécurité HTTPS avec certificat SSL, garantissant un chiffrement des échanges et la confidentialité de vos informations.<\/p><p>Nous veillons à la protection de vos données personnelles tout au long de votre parcours, que ce soit lors de la navigation, de la connexion à votre compte ou au moment de votre commande.<\/p><p>Pour les règlements, nous avons choisi des solutions reconnues mondialement pour leur fiabilité : <strong>PayPal<\/strong> et <strong>Stripe<\/strong>. Ces plateformes assurent un traitement sécurisé des paiements, afin que vous puissiez commander en toute confiance.<\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_zj3Mdr"]},"accordion_row_c8wLcT":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Que faire si ma commande ne me convient pas ?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_MQd4TP":{"type":"text","name":"t:names.text","settings":{"text":"<p>Votre satisfaction est essentielle. Si, pour une raison quelconque, votre commande ne répond pas à vos attentes, vous disposez d’un délai de <strong>14 jours à compter de la réception<\/strong> pour nous retourner l’article concerné.<\/p><p>Dès réception du produit dans nos locaux et après vérification de son état, nous procéderons à son <strong>remboursement intégral<\/strong>.<\/p><p>Les articles retournés doivent toutefois être <strong>en parfait état<\/strong>, <strong>jamais portés<\/strong>, et les <strong>frais de retour restent à votre charge<\/strong>. Nous vous invitons également à nous transmettre par e-mail une <strong>preuve d’envoi<\/strong> afin de confirmer l’expédition du retour.<\/p><p>Avant toute démarche, nous vous recommandons de consulter notre <strong>politique de retour et de remboursement<\/strong> disponible sur notre site.<br\/><\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_MQd4TP"]}},"block_order":["accordion_row_9eH3YQ","accordion_row_6BRHeG","accordion_row_KM8rYE","accordion_row_c8wLcT"]}},"block_order":["text_XCn9fQ","accordion_AMxmYb"],"name":"t:names.faq_section","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":32,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":48,"padding-block-end":48}}},"order":["section","main","section_mf3kwU"]}