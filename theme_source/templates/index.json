    "section_66pAzb": {
      "type": "section",
      "blocks": {
        "text_H6amF8": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h2>FAQ</h2>",
            "width": "fit-content",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "h3",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
